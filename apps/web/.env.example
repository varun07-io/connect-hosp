# Copy to .env.local and adjust.

VITE_API_URL=http://localhost:4000

# Optional — only needed once you create a Firebase project and want real OTP /
# staff login instead of the dev "log in as" switcher (which works with none of
# these set, as long as the API's DEV_AUTH_BYPASS=true).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
