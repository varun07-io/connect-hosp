// Connect Hospital — Phase 2 extended data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  HOSPITAL_ADMIN
  DOCTOR
  VERIFICATION
  SUPPORT
  SUPER_ADMIN
  FIELD_EXECUTIVE_HOSPITAL
  FIELD_EXECUTIVE_CONNECT
  FE_MANAGER
}

enum HospitalStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum EnquiryIntent {
  SURGERY
  SECOND_OPINION
}

enum EnquiryStatus {
  NEW
  ACKNOWLEDGED
  ASSIGNED
  CONTACTED
  GUIDED
  CLOSED
  CANCELLED
  NO_RESPONSE
  REOPENED
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum RecordCategory {
  LAB_REPORT
  PRESCRIPTION
  IMAGING
  OTHER
}

enum VerificationDecisionType {
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum CallbackOutcome {
  REACHED
  NOT_REACHED
  CALL_BACK_LATER
}

// ─── Phase 2 enums ───────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUND_INITIATED
  REFUNDED
}

enum RefundType {
  SLA_AUTO
  PATIENT_CANCEL
  DISPUTE
  MANUAL
}

enum RefundStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum KycType {
  PATIENT
  STAFF
}

enum KycMethod {
  DIGILOCKER
  MANUAL
}

enum KycDocType {
  AADHAAR
  PAN
  VOTER_ID
  PASSPORT
  MCI_CERT
  HOSPITAL_AUTH
  EMPLOYEE_ID
}

enum FeType {
  HOSPITAL
  CONNECT_HOSPITAL
}

enum FeAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FollowUpStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ESCALATED
}

enum FollowUpActionType {
  PHONE_CALL
  PHYSICAL_VISIT
  DOCUMENT_COLLECTED
  ADMISSION_CONFIRMED
  OTHER
}

// ─── Core models ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  firebaseUid  String    @unique
  role         Role
  name         String
  email        String?   @unique
  phone        String?   @unique
  status       String    @default("ACTIVE")
  hospitalId   String?
  hospital     Hospital? @relation("HospitalStaff", fields: [hospitalId], references: [id])
  // Phase 2: fast KYC gate check (denormalised from kyc_verifications)
  kycStatus    KycStatus @default(UNVERIFIED)
  kycVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patientProfile        Patient?
  doctorProfile         Doctor?
  notificationPrefs     NotificationPreference?
  fieldExecutiveProfile FieldExecutive?
  kycVerification       KycVerification?

  enquiriesRaised       Enquiry[]              @relation("PatientEnquiries")
  auditLogs             AuditLog[]             @relation("AuditActor")
  supportTicketsRaised  SupportTicket[]        @relation("TicketRaisedBy")
  supportTicketsOwned   SupportTicket[]        @relation("TicketAssignedTo")
  verificationDecisions VerificationDecision[] @relation("DecisionReviewer")
  enquiryStatusChanges  EnquiryStatusHistory[] @relation("StatusActor")
  refundsInitiated      PaymentRefund[]        @relation("RefundInitiator")
  kycReviewed           KycVerification[]      @relation("KycReviewer")

  @@index([hospitalId])
  @@index([role])
}

model Patient {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String?
  createdAt DateTime @default(now())

  medicalRecords MedicalRecord[]
  consents       Consent[]
  reviews        Review[]
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  smsEnabled      Boolean @default(true)
  whatsappEnabled Boolean @default(true)
  emailEnabled    Boolean @default(true)
}

model Doctor {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId      String
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  specialisation  String
  qualifications  String
  experienceYears Int      @default(0)
  bio             String?
  photoUrl        String?
  createdAt       DateTime @default(now())

  assignedEnquiries Enquiry[] @relation("AssignedDoctor")

  @@index([hospitalId])
}

model Hospital {
  id                         String         @id @default(cuid())
  name                       String
  slug                       String         @unique
  status                     HospitalStatus @default(PENDING)
  description                String?
  specialities               String[]       @default([])
  facilities                 String[]       @default([])
  accreditations             String[]       @default([])
  photos                     String[]       @default([])
  city                       String
  address                    String
  latitude                   Float?
  longitude                  Float?
  contactPersonName          String
  contactPersonPhone         String
  contactPersonEmail         String
  // Phase 2: payment configuration
  depositRequired            Boolean        @default(false)
  depositAmountSurgery       Int            @default(0)
  depositAmountSecondOpinion Int            @default(0)
  slaCallbackHours           Int            @default(48)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  staff                 User[]                   @relation("HospitalStaff")
  doctors               Doctor[]
  treatmentPrices       HospitalTreatmentPrice[]
  enquiries             Enquiry[]
  reviews               Review[]
  apiKeys               ApiKey[]
  verificationDocs      VerificationDocument[]
  verificationDecisions VerificationDecision[]
  fieldExecutives       FieldExecutive[]

  @@index([city])
  @@index([status])
}

model Treatment {
  id       String @id @default(cuid())
  name     String @unique
  category String

  hospitalPrices HospitalTreatmentPrice[]
  enquiries      Enquiry[]
}

model HospitalTreatmentPrice {
  id              String    @id @default(cuid())
  hospitalId      String
  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatmentId     String
  treatment       Treatment @relation(fields: [treatmentId], references: [id])
  indicativePrice Decimal   @db.Decimal(12, 2)
  currency        String    @default("INR")
  notes           String?

  @@unique([hospitalId, treatmentId])
  @@index([treatmentId])
}

model Enquiry {
  id                      String          @id @default(cuid())
  patientId               String
  patient                 User            @relation("PatientEnquiries", fields: [patientId], references: [id])
  hospitalId              String
  hospital                Hospital        @relation(fields: [hospitalId], references: [id])
  intent                  EnquiryIntent
  treatmentId             String?
  treatment               Treatment?      @relation(fields: [treatmentId], references: [id])
  condition               String
  preferredCallbackWindow String
  status                  EnquiryStatus   @default(NEW)
  assignedDoctorId        String?
  assignedDoctor          Doctor?         @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])
  callbackOutcome         CallbackOutcome?
  callbackNotes           String?
  // Phase 2: payment + FE links
  paymentRequired         Boolean         @default(false)
  paymentId               String?         @unique
  payment                 Payment?        @relation(fields: [paymentId], references: [id])
  feQueueId               String?         @unique
  feQueue                 FeBookingQueue? @relation("EnquiryFeQueue", fields: [feQueueId], references: [id])
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  statusHistory EnquiryStatusHistory[]
  attachments   EnquiryRecordAttachment[]
  consents      Consent[]
  notifications Notification[]
  supportTickets SupportTicket[]

  @@index([hospitalId, status])
  @@index([patientId])
  @@index([assignedDoctorId])
}

model EnquiryStatusHistory {
  id         String         @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus EnquiryStatus?
  toStatus   EnquiryStatus
  actorId    String?
  actor      User?          @relation("StatusActor", fields: [actorId], references: [id])
  note       String?
  createdAt  DateTime       @default(now())

  @@index([enquiryId])
}

model MedicalRecord {
  id         String         @id @default(cuid())
  patientId  String
  patient    Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title      String
  category   RecordCategory
  fileKey    String
  mimeType   String
  sizeBytes  Int
  recordedAt DateTime?
  createdAt  DateTime       @default(now())

  attachments EnquiryRecordAttachment[]

  @@index([patientId])
}

model EnquiryRecordAttachment {
  id              String        @id @default(cuid())
  enquiryId       String
  enquiry         Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  attachedAt      DateTime      @default(now())

  @@unique([enquiryId, medicalRecordId])
}

model Consent {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  enquiryId     String
  enquiry       Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  recordsShared Boolean  @default(false)
  grantedAt     DateTime @default(now())

  @@index([enquiryId])
}

model Review {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientId  String?
  patient    Patient? @relation(fields: [patientId], references: [id])
  rating     Int
  comment    String?
  seeded     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

model Notification {
  id          String              @id @default(cuid())
  enquiryId   String?
  enquiry     Enquiry?            @relation(fields: [enquiryId], references: [id])
  recipient   String
  channel     NotificationChannel
  template    String
  status      NotificationStatus  @default(QUEUED)
  providerRef String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([enquiryId])
  @@index([status])
}

model ApiKey {
  id         String    @id @default(cuid())
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  label      String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([hospitalId])
}

model VerificationDocument {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  docType    String
  fileKey    String
  uploadedAt DateTime @default(now())

  @@index([hospitalId])
}

model VerificationDecision {
  id         String                   @id @default(cuid())
  hospitalId String
  hospital   Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User                     @relation("DecisionReviewer", fields: [reviewerId], references: [id])
  decision   VerificationDecisionType
  reason     String?
  decidedAt  DateTime                 @default(now())

  @@index([hospitalId])
}

model SupportTicket {
  id           String   @id @default(cuid())
  raisedById   String
  raisedBy     User     @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  enquiryId    String?
  enquiry      Enquiry? @relation(fields: [enquiryId], references: [id])
  subject      String
  status       String   @default("OPEN")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ─── Phase 2: Field Executive ─────────────────────────────────────────────────

model FieldExecutive {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  feType      FeType
  hospitalId  String?
  hospital    Hospital?       @relation(fields: [hospitalId], references: [id])
  managerId   String?
  manager     FieldExecutive? @relation("FeManager", fields: [managerId], references: [id])
  reports     FieldExecutive[] @relation("FeManager")
  status      FeAccountStatus @default(ACTIVE)
  kycVerified Boolean         @default(false)
  isDeleted   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  assignedBookings FeBookingQueue[] @relation("AssignedFe")
  followUpLogs     FeFollowUpLog[]

  @@index([hospitalId])
  @@index([feType])
}

model FeBookingQueue {
  id             String          @id @default(cuid())
  feId           String?
  fe             FieldExecutive? @relation("AssignedFe", fields: [feId], references: [id])
  assignedAt     DateTime?
  followUpStatus FollowUpStatus  @default(NOT_STARTED)
  admissionRef   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  enquiry      Enquiry?       @relation("EnquiryFeQueue")
  followUpLogs FeFollowUpLog[]

  @@index([feId])
  @@index([followUpStatus])
}

model FeFollowUpLog {
  id             String             @id @default(cuid())
  feQueueId      String
  feQueue        FeBookingQueue     @relation(fields: [feQueueId], references: [id])
  feId           String
  fe             FieldExecutive     @relation(fields: [feId], references: [id])
  actionType     FollowUpActionType
  notes          String
  nextStep       String?
  followUpDate   DateTime
  createdAt      DateTime           @default(now())

  @@index([feQueueId])
}

// ─── Phase 2: Payments ────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  enquiry           Enquiry?
  amount            Int
  currency          String        @default("INR")
  gateway           String        @default("razorpay")
  gatewayOrderId    String        @unique
  gatewayPaymentId  String?       @unique
  status            PaymentStatus @default(PENDING)
  webhookPayload    Json?
  createdAt         DateTime      @default(now())
  verifiedAt        DateTime?

  refunds PaymentRefund[]

  @@index([status])
}

model PaymentRefund {
  id              String       @id @default(cuid())
  paymentId       String
  payment         Payment      @relation(fields: [paymentId], references: [id])
  gatewayRefundId String?
  amount          Int
  reason          String
  refundType      RefundType
  status          RefundStatus @default(INITIATED)
  initiatedById   String?
  initiatedBy     User?        @relation("RefundInitiator", fields: [initiatedById], references: [id])
  createdAt       DateTime     @default(now())

  @@index([paymentId])
}

// ─── Phase 2: KYC & Documents ─────────────────────────────────────────────────

model KycVerification {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycType        KycType
  status         KycStatus  @default(UNVERIFIED)
  method         KycMethod?
  digilockerRef  String?
  verifiedAt     DateTime?
  rejectedReason String?
  reviewedById   String?
  reviewedBy     User?      @relation("KycReviewer", fields: [reviewedById], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  documents KycDocument[]
}

model KycDocument {
  id           String          @id @default(cuid())
  kycId        String
  kyc          KycVerification @relation(fields: [kycId], references: [id], onDelete: Cascade)
  docType      KycDocType
  fileRef      String
  fileSizeKb   Int?
  uploadedAt   DateTime        @default(now())
  isDeleted    Boolean         @default(false)

  @@index([kycId])
}

// ─── Government hospital directory (KASS empanelment list) ──────────────────

/// Public directory of government hospitals, maintained by Excel import
/// (see routes/govtHospitals.ts). Separate from `Hospital`: these are listings
/// for discovery, not marketplace partners with doctors, prices or bookings.
model GovtHospital {
  id           String   @id @default(cuid())
  /// Identity across uploads: "ref:<Empanelment Ref-ID>", or
  /// "name:<name>|<district>|<taluk>" when the row has no Ref-ID.
  key          String   @unique
  refId        String?
  name         String
  district     String
  taluk        String?
  address      String?
  specialities String[] @default([])
  subType      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([district])
}
