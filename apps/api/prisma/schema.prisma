// Connect Hospital POC — data model.
// Traces to Appendix B of Connect Hospital Scope.pdf, extended with the
// status/audit tables the modules in Section 6 actually need.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  HOSPITAL_ADMIN
  DOCTOR
  VERIFICATION
  SUPPORT
  SUPER_ADMIN
}

enum HospitalStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum EnquiryIntent {
  SURGERY
  SECOND_OPINION
}

enum EnquiryStatus {
  NEW
  ACKNOWLEDGED
  ASSIGNED
  CONTACTED
  GUIDED
  CLOSED
  CANCELLED
  NO_RESPONSE
  REOPENED
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum RecordCategory {
  LAB_REPORT
  PRESCRIPTION
  IMAGING
  OTHER
}

enum VerificationDecisionType {
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum CallbackOutcome {
  REACHED
  NOT_REACHED
  CALL_BACK_LATER
}

/// Every human who can sign in. Firebase Auth proves identity;
/// role + hospital scoping live here (Section 5, Role & Permissions Principle).
model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  role        Role
  name        String
  email       String?  @unique
  phone       String?  @unique
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED
  hospitalId  String?
  hospital    Hospital? @relation("HospitalStaff", fields: [hospitalId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patientProfile      Patient?
  doctorProfile        Doctor?
  notificationPrefs    NotificationPreference?

  enquiriesRaised      Enquiry[]            @relation("PatientEnquiries")
  auditLogs            AuditLog[]           @relation("AuditActor")
  supportTicketsRaised SupportTicket[]      @relation("TicketRaisedBy")
  supportTicketsOwned  SupportTicket[]      @relation("TicketAssignedTo")
  verificationDecisions VerificationDecision[] @relation("DecisionReviewer")
  enquiryStatusChanges  EnquiryStatusHistory[] @relation("StatusActor")

  @@index([hospitalId])
  @@index([role])
}

/// Patient-specific fields, 1:1 with User (PAT-02).
model Patient {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String?
  createdAt DateTime @default(now())

  medicalRecords MedicalRecord[]
  consents       Consent[]
  reviews        Review[]
}

model NotificationPreference {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  smsEnabled   Boolean @default(true)
  whatsappEnabled Boolean @default(true)
  emailEnabled Boolean @default(true)
}

/// Doctor-specific fields, 1:1 with User (DOC module). hospitalId duplicated
/// from User.hospitalId for query convenience and is kept in sync at write time.
model Doctor {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId       String
  hospital         Hospital @relation(fields: [hospitalId], references: [id])
  specialisation   String
  qualifications   String
  experienceYears  Int      @default(0)
  bio              String?
  photoUrl         String?
  createdAt        DateTime @default(now())

  assignedEnquiries Enquiry[] @relation("AssignedDoctor")

  @@index([hospitalId])
}

/// A hospital listing (VER + HSP modules).
model Hospital {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  status             HospitalStatus @default(PENDING)
  description        String?
  specialities       String[]       @default([])
  facilities         String[]       @default([])
  accreditations     String[]       @default([])
  photos             String[]       @default([])
  city               String
  address            String
  latitude           Float?
  longitude          Float?
  contactPersonName  String
  contactPersonPhone String
  contactPersonEmail String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  staff              User[]                 @relation("HospitalStaff")
  doctors            Doctor[]
  treatmentPrices    HospitalTreatmentPrice[]
  enquiries          Enquiry[]
  reviews            Review[]
  apiKeys            ApiKey[]
  verificationDocs   VerificationDocument[]
  verificationDecisions VerificationDecision[]

  @@index([city])
  @@index([status])
}

/// Global curated treatment catalogue (Section 8.2).
model Treatment {
  id       String @id @default(cuid())
  name     String @unique
  category String

  hospitalPrices HospitalTreatmentPrice[]
  enquiries      Enquiry[]
}

/// HSP-04 indicative price list, per hospital per treatment.
model HospitalTreatmentPrice {
  id              String    @id @default(cuid())
  hospitalId      String
  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatmentId     String
  treatment       Treatment @relation(fields: [treatmentId], references: [id])
  indicativePrice Decimal   @db.Decimal(12, 2)
  currency        String    @default("INR")
  notes           String?

  @@unique([hospitalId, treatmentId])
  @@index([treatmentId])
}

/// The pivotal entity — BKG module / Episodes A & B.
model Enquiry {
  id                       String        @id @default(cuid())
  patientId                String
  patient                  User          @relation("PatientEnquiries", fields: [patientId], references: [id])
  hospitalId               String
  hospital                 Hospital      @relation(fields: [hospitalId], references: [id])
  intent                   EnquiryIntent
  treatmentId              String?
  treatment                Treatment?    @relation(fields: [treatmentId], references: [id])
  condition                String
  preferredCallbackWindow  String
  status                   EnquiryStatus @default(NEW)
  assignedDoctorId         String?
  assignedDoctor           Doctor?       @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])
  callbackOutcome          CallbackOutcome?
  callbackNotes            String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  statusHistory   EnquiryStatusHistory[]
  attachments     EnquiryRecordAttachment[]
  consents        Consent[]
  notifications   Notification[]
  supportTickets  SupportTicket[]

  @@index([hospitalId, status])
  @@index([patientId])
  @@index([assignedDoctorId])
}

/// BKG-06 status lifecycle, timestamped + attributed for audit/response-time reporting.
model EnquiryStatusHistory {
  id         String        @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus EnquiryStatus?
  toStatus   EnquiryStatus
  actorId    String?
  actor      User?         @relation("StatusActor", fields: [actorId], references: [id])
  note       String?
  createdAt  DateTime      @default(now())

  @@index([enquiryId])
}

/// VLT module — the patient's private medical-records vault.
model MedicalRecord {
  id         String         @id @default(cuid())
  patientId  String
  patient    Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title      String
  category   RecordCategory
  fileKey    String // storage-provider object key, never a public URL
  mimeType   String
  sizeBytes  Int
  recordedAt DateTime?
  createdAt  DateTime       @default(now())

  attachments EnquiryRecordAttachment[]

  @@index([patientId])
}

/// VLT-04/05 — a record is shared with a hospital only via an explicit,
/// per-enquiry attachment; the record itself is never hospital-visible otherwise.
model EnquiryRecordAttachment {
  id              String        @id @default(cuid())
  enquiryId       String
  enquiry         Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  attachedAt      DateTime      @default(now())

  @@unique([enquiryId, medicalRecordId])
}

/// BKG-02 consent capture, kept as its own auditable event.
model Consent {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  enquiryId      String
  enquiry        Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  recordsShared  Boolean  @default(false)
  grantedAt      DateTime @default(now())

  @@index([enquiryId])
}

/// DIS-07 ratings & reviews.
model Review {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientId  String?
  patient    Patient? @relation(fields: [patientId], references: [id])
  rating     Int
  comment    String?
  seeded     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

/// NOT module — every notification attempt, for delivery logging (NOT-05).
model Notification {
  id          String              @id @default(cuid())
  enquiryId   String?
  enquiry     Enquiry?            @relation(fields: [enquiryId], references: [id])
  recipient   String
  channel     NotificationChannel
  template    String
  status      NotificationStatus  @default(QUEUED)
  providerRef String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([enquiryId])
  @@index([status])
}

/// NOT-06/07 hospital API auth.
model ApiKey {
  id         String    @id @default(cuid())
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  label      String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([hospitalId])
}

/// VER-01/03 registration documents awaiting review.
model VerificationDocument {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  docType    String
  fileKey    String
  uploadedAt DateTime @default(now())

  @@index([hospitalId])
}

/// VER-03/05 the reviewed decision + audit trail.
model VerificationDecision {
  id         String                    @id @default(cuid())
  hospitalId String
  hospital   Hospital                  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User                      @relation("DecisionReviewer", fields: [reviewerId], references: [id])
  decision   VerificationDecisionType
  reason     String?
  decidedAt  DateTime                  @default(now())

  @@index([hospitalId])
}

/// SUP module.
model SupportTicket {
  id           String   @id @default(cuid())
  raisedById   String
  raisedBy     User     @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  enquiryId    String?
  enquiry      Enquiry? @relation(fields: [enquiryId], references: [id])
  subject      String
  status       String   @default("OPEN") // OPEN | IN_PROGRESS | ESCALATED | RESOLVED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

/// ADM-06 platform-wide immutable audit trail for every privileged/status-changing action.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
