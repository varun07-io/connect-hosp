# Copy to .env and adjust. Nothing below is required to get the app running
# locally with docker-compose — every external integration has a working
# local/mock fallback (see src/lib/notifications, src/lib/storage).

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Matches infra/docker-compose.yml
DATABASE_URL="postgresql://connect:connect@localhost:5434/connect_hospital?schema=public"

# Dev-only auth shortcut — lets you "log in" as any seeded user without Firebase.
# Must be false in every deployed environment (enforced at boot in src/env.ts).
DEV_AUTH_BYPASS=true

# --- Firebase Admin (required once DEV_AUTH_BYPASS=false) ---
# From your Firebase project's service account JSON.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Notifications (Phase 2 — MockNotificationProvider is used until these are set) ---
# MSG91_AUTH_KEY=
# RESEND_API_KEY=

# --- Storage (Phase 2 — LocalDiskStorageProvider is used until these are set) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- AWS S3 (Phase 2 — preferred over R2 for production deployments on AWS) ---
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_MEDICAL=connect-hospital-medical-records
# S3_BUCKET_KYC=connect-hospital-kyc
# S3_BUCKET_HOSPITAL_DOCS=connect-hospital-hospital-docs
# S3_BUCKET_PAYMENT_RECEIPTS=connect-hospital-payment-receipts

# --- Payments switch ---
# Off for the prototype: no deposits, no payment prompts or checks, no SLA
# refund job; deposit/payment fields are hidden from every API response.
# Set to true to restore the full deposit + Razorpay flow.
PAYMENTS_ENABLED=false

# --- Razorpay (Phase 2 — required when depositRequired=true hospitals exist) ---
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Any long random string; signs expiring vault-file download links.
FILE_SIGNING_SECRET=dev-only-insecure-signing-secret-change-me
